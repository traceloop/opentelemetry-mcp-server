# Backend Configuration
# Supported backends: jaeger, tempo, traceloop
BACKEND_TYPE=jaeger

# Backend URL (optional when BACKEND_URLS is set)
# Examples:
#   Jaeger: http://localhost:16686
#   Tempo: http://localhost:3200
#   Traceloop: https://api.traceloop.com/v2
BACKEND_URL=http://localhost:16686

# Optional: Named backend URLs for multi-environment routing.
# Accepts comma-separated 'name=url' pairs or a JSON object.
# Every tool gains an optional 'environment' parameter that routes to the
# matching backend; when omitted, DEFAULT_ENVIRONMENT is used.
#   BACKEND_URLS=prod=http://localhost:16686,qa=http://localhost:16687
#   BACKEND_URLS={"prod":"http://localhost:16686","qa":"http://localhost:16687"}
BACKEND_URLS=

# Optional: Environment name used when a tool call omits 'environment'
# (default: 'default'). Must name one of the keys in BACKEND_URLS.
# Only relevant when BACKEND_URLS is set.
DEFAULT_ENVIRONMENT=default

# Optional: API key for authenticated backends (mainly for Traceloop)
BACKEND_API_KEY=

# Optional: Comma-separated list of environments for Traceloop backend (default: production)
# Only used when BACKEND_TYPE=traceloop
BACKEND_ENVIRONMENTS=production

# Optional: Request timeout in seconds (default: 30)
BACKEND_TIMEOUT=30

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Maximum traces per query (default: 100, max: 1000)
MAX_TRACES_PER_QUERY=100
